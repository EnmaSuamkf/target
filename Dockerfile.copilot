# The Target Project — agent image for `runner: copilot` + `sandbox: docker`.
#
# The broker invokes the runner's binary as the container command:
#   docker run --rm ... <image> copilot -p "<step>" ...
# so this image ships the GitHub Copilot CLI (`copilot`). Requires
# target-agent:latest as its base (see ./Dockerfile).
#
#   docker build -t target-agent-copilot:latest -f Dockerfile.copilot .
#
# Credentials arrive at run time — the token variable `COPILOT_GITHUB_TOKEN`
# forwarded by name (host keyring logins are not usable inside a container)
# and the mounted `~/.copilot` tree — never bake a token into the image.

FROM target-agent:latest

# npm -g needs root; we drop back to the non-root user at the end.
USER root

# Pin this to a release (e.g. 1.0.91) for reproducible builds. With `latest`,
# two builds on different days can produce different versions.
ARG COPILOT_VERSION=latest

# Same ids the base image was built with (the installer and the hub's
# on-demand build pass the operator's own uid/gid to both). Redeclared here
# because an ARG from before the FROM is out of scope after it, and used for
# the final USER below.
ARG AGENT_UID=1000
ARG AGENT_GID=1000

# The CLI must never try to replace itself inside a throwaway container.
ENV COPILOT_AUTO_UPDATE=false

# The global prefix (/usr/local) is root-owned but world-readable; chmod keeps
# it readable and executable for the container user (AGENT_UID).
RUN npm install -g --no-audit --no-fund "@github/copilot@${COPILOT_VERSION}" \
	&& npm cache clean --force \
	&& chmod -R a+rX /usr/local/lib/node_modules/@github/copilot

# Same rule as the base image: nothing runs as root.
USER ${AGENT_UID}:${AGENT_GID}

CMD ["copilot", "--help"]
