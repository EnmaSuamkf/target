# The Target Project — agent image for `runner: cursor` + `sandbox: docker`.
#
# The broker invokes the runner's binary as the container command:
#   docker run --rm ... <image> agent -p "<step>" ...
# so this image ships the Cursor Agent CLI (`agent`). Requires
# target-agent:latest as its base (see ./Dockerfile).
#
#   docker build -t target-agent-cursor:latest -f Dockerfile.cursor .
#
# Credentials arrive at run time via the mounted `~/.cursor` tree or
# `CURSOR_API_KEY` — never bake a key into the image.

FROM target-agent:latest

USER root

ARG AGENT_UID=1000
ARG AGENT_GID=1000

# Install the Cursor Agent CLI. The official installer puts a versioned bundle
# (wrapper + bundled node + index.js) under ~/.local/share/cursor-agent and a
# symlink at ~/.local/bin/agent. Copying only the wrapper to /usr/local/bin, as
# the old Dockerfile did, breaks it: the wrapper resolves node/index.js relative
# to its own directory. Install under /opt so the container user (AGENT_UID) can
# read it — /root/.local is root-only and the broker runs as the operator's uid.
RUN apt-get update \
	&& apt-get install -y --no-install-recommends curl ca-certificates \
	&& curl -fsS https://cursor.com/install | bash \
	&& AGENT_REAL="$(readlink -f /root/.local/bin/agent)" \
	&& AGENT_DIR="$(dirname "$AGENT_REAL")" \
	&& install -d /opt/cursor-agent \
	&& cp -a "$AGENT_DIR" "/opt/cursor-agent/$(basename "$AGENT_DIR")" \
	&& ln -sf "/opt/cursor-agent/$(basename "$AGENT_DIR")/cursor-agent" /usr/local/bin/agent \
	&& chmod -R a+rX /opt/cursor-agent \
	&& apt-get purge -y curl \
	&& apt-get autoremove -y \
	&& rm -rf /var/lib/apt/lists/*

USER ${AGENT_UID}:${AGENT_GID}

CMD ["agent", "--help"]
