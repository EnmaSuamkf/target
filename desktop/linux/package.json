{
  "name": "target-desktop-linux",
  "version": "0.2.0",
  "description": "Linux desktop shell for The Target Project — embeds the React hub UI in Electron.",
  "author": "The Target Project",
  "homepage": "https://github.com/EnmaSuamkf/target",
  "desktopName": "target-for-linux.desktop",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node link-shared.mjs",
    "prestart": "node link-shared.mjs",
    "prebuild": "node link-shared.mjs",
    "start": "node run.mjs",
    "dev": "node run.mjs",
    "build": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12"
  },
  "allowScripts": {
    "electron@35.7.5": true
  },
  "build": {
    "appId": "com.target.project.linux",
    "productName": "Target for Linux",
    "copyright": "Copyright © The Target Project",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.mjs",
      "run.mjs",
      "shared/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../",
        "to": "target",
        "filter": [
          "hub/**/*",
          "hub/node_modules/**/*",
          "scripts/**/*",
          "package.json",
          "vendor/**/*",
          "!hub/ui/node_modules/**",
          "!**/.git/**"
        ]
      }
    ],
    "linux": {
      "category": "Development",
      "maintainer": "The Target Project <target@example.com>",
      "executableName": "target-for-linux",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "Target for Linux",
          "Comment": "The Target Project — workflow hub",
          "Categories": "Development;Utility;",
          "StartupWMClass": "target-for-linux"
        }
      },
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
