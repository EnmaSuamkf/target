{
  "name": "target-desktop-mac",
  "version": "0.2.0",
  "description": "macOS desktop shell for The Target Project — embeds the React hub UI in Electron.",
  "author": "The Target Project",
  "homepage": "https://github.com/EnmaSuamkf/target",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node link-shared.mjs",
    "prestart": "node link-shared.mjs",
    "prebuild": "node link-shared.mjs",
    "start": "node run.mjs",
    "dev": "node run.mjs",
    "build": "node build.mjs"
  },
  "devDependencies": {
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12"
  },
  "allowScripts": {
    "electron@35.7.5": true
  },
  "build": {
    "appId": "com.target.project.mac",
    "productName": "Target for Mac",
    "copyright": "Copyright © The Target Project",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.mjs",
      "run.mjs",
      "shared/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../",
        "to": "target",
        "filter": [
          "hub/**/*",
          "hub/node_modules/**/*",
          "scripts/**/*",
          "package.json",
          "vendor/**/*",
          "!hub/ui/node_modules/**",
          "!**/.git/**"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ],
      "identity": null
    },
    "dmg": {
      "title": "Target for Mac ${version}",
      "backgroundColor": "#ffffff"
    }
  }
}
